      },
      "widgets_values": [
        "cfg stays at 1.0 and steps at 4 for distilled Klein.\ndenoise stays at 1.0 - the edit is held by the conditioning,\nnot by the noise level."
      ],
      "color": "#432",
      "bgcolor": "#653"
    }
